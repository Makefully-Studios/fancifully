{
  "id": "demo-book",
  "title": "Fancifully Sample",
  "pageSize": { "width": 600, "height": 800 },
  "layout": {
    "mode": "auto",
    "singleBreakpoint": 900
  },
  "fonts": [],
  "assets": {
    "coverBg": { "type": "image", "src": "images/cover.svg" },
    "forestBg": { "type": "image", "src": "images/forest.svg" },
    "cottageBg": { "type": "image", "src": "images/cottage.svg" },
    "meadowBg": { "type": "image", "src": "images/meadow.svg" },
    "clickSfx": { "type": "audio", "src": "audio/click.wav", "channel": "sfx" },
    "p1Vo": { "type": "audio", "src": "audio/silence.wav", "channel": "vo" },
    "p1Vtt": { "type": "vtt", "src": "audio/page1.vtt" },
    "p2Vo": { "type": "audio", "src": "audio/silence.wav", "channel": "vo" },
    "p2Vtt": { "type": "vtt", "src": "audio/page2.vtt" },
    "p3Vo": { "type": "audio", "src": "audio/silence.wav", "channel": "vo" },
    "p3Vtt": { "type": "vtt", "src": "audio/page3.vtt" }
  },
  "pages": [
    {
      "id": "cover",
      "background": { "asset": "coverBg", "color": "#f3e7d3" },
      "readAloud": {
        "audio": "p1Vo",
        "cues": "p1Vtt"
      },
      "blocks": [
        {
          "id": "title",
          "type": "text",
          "layout": { "x": "8%", "y": "12%", "width": "84%" },
          "html": "<p style=\"text-align:center;font-size:42px;margin:0\"><span id=\"w1\">Once</span> <span id=\"w2\">upon</span> <span id=\"w3\">a</span> <span id=\"w4\">hill</span></p>",
          "style": { "fontFamily": "Georgia, serif", "color": "#2a241c" }
        },
        {
          "id": "hero",
          "type": "image",
          "asset": "coverBg",
          "layout": { "x": "10%", "y": "40%", "width": "80%", "height": "45%", "fit": "cover" }
        },
        {
          "id": "lamp",
          "type": "hotspot",
          "layout": { "x": "65%", "y": "55%", "width": "22%", "height": "28%" },
          "ariaLabel": "Light the hill",
          "onTap": [
            { "play": "clickSfx" },
            { "toggleClass": { "target": "hero", "className": "lit" } }
          ]
        }
      ]
    },
    {
      "id": "forest",
      "background": { "asset": "forestBg", "color": "#dfe8d8" },
      "readAloud": { "audio": "p2Vo", "cues": "p2Vtt" },
      "blocks": [
        {
          "id": "copy",
          "type": "text",
          "layout": { "x": "8%", "y": "10%", "width": "84%" },
          "html": "<p><span id=\"f1\">The</span> <span id=\"f2\">trees</span> <span id=\"f3\">leaned</span> <span id=\"f4\">in</span> <span id=\"f5\">to</span> <span id=\"f6\">listen.</span></p>",
          "style": { "fontSize": "28px", "color": "#1d2a1a" }
        }
      ]
    },
    {
      "id": "cottage",
      "background": { "asset": "cottageBg", "color": "#f0e0d0" },
      "readAloud": { "audio": "p3Vo", "cues": "p3Vtt" },
      "blocks": [
        {
          "id": "copy",
          "type": "text",
          "layout": { "x": "8%", "y": "12%", "width": "84%" },
          "html": "<p><span id=\"c1\">A</span> <span id=\"c2\">window</span> <span id=\"c3\">glowed</span> <span id=\"c4\">like</span> <span id=\"c5\">honey.</span></p>",
          "style": { "fontSize": "28px", "color": "#3a2416" }
        }
      ]
    },
    {
      "id": "meadow",
      "background": { "asset": "meadowBg", "color": "#e8f0d8" },
      "blocks": [
        {
          "id": "copy",
          "type": "text",
          "layout": { "x": "8%", "y": "40%", "width": "84%" },
          "html": "<p style=\"text-align:center\">The end — for now.</p>",
          "style": { "fontSize": "32px", "color": "#243018" }
        }
      ]
    }
  ]
}
